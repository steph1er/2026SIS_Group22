# Optional overrides. The checked-in defaults work for normal local development.
# Copy this file to .env only when an override is needed, then start Uvicorn with
# --env-file .env.

# Comma-separated browser origins allowed to call the service. Native Expo apps
# do not use browser CORS.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006

# Relative to ml-service/ when Uvicorn is started from that directory.
FACE_LANDMARKER_MODEL_PATH=models/face_landmarker.task
